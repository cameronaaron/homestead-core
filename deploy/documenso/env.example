# Copy to .env (git-ignored). Generate secrets with: openssl rand -base64 32
POSTGRES_USER=documenso
POSTGRES_PASSWORD=
POSTGRES_DB=documenso

NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

# Where people open signing links, e.g. https://sign.sunbrewedhomestead.org
NEXT_PUBLIC_WEBAPP_URL=
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000

# Written by make-cert.sh
NEXT_PRIVATE_SIGNING_PASSPHRASE=

# Outgoing email (signing requests and completed copies)
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_FROM_NAME=Sun Brewed Homestead
NEXT_PRIVATE_SMTP_FROM_ADDRESS=

# Webhooks to private addresses are refused (SSRF protection). If the
# homestead core is reached over a private network (same host or VPC), list
# its hostname or IP here, e.g. homestead-core or 10.0.0.5.
NEXT_PRIVATE_WEBHOOK_SSRF_BYPASS_HOSTS=
