# Copy to .env (git-ignored). `just run` loads it.

# Supabase: use the SESSION pooler (port 5432) or direct connection, not the
# transaction pooler (6543) — it breaks prepared statements and LISTEN.
DATABASE_URL=postgres://postgres:homestead@localhost:54329/homestead

# Optional legacy API bearer token (>= 32 chars; openssl rand -hex 32). People
# sign in with their own accounts (`just user-add`); services get their own
# API tokens on the People page. Leave blank unless a script still needs it.
ADMIN_TOKEN=

# Everything that isn't a secret is in homestead.toml (point HOMESTEAD_CONFIG
# at another file to override it, e.g. one with secure_cookies = false for
# local http). BIND_ADDR overrides [server].bind.

# ── Integrations: each switches on when its settings are present ──────────
# Discord notifications: Server Settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=
# For `just discord-provision` / `just discord-register`.
# Developer Portal → your app → Bot → Reset Token.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
# Developer Portal → OAuth2 → Client Secret. Used only after paperwork is signed.
DISCORD_CLIENT_SECRET=
# Discord → Settings → Advanced → Developer Mode; right-click server → Copy Server ID.
DISCORD_GUILD_ID=

# Linear: Settings → Security & access → Personal API keys. (Team: homestead.toml.)
LINEAR_API_KEY=

# Zeffy: Settings → Integrations → API keys (read-only).
ZEFFY_API_KEY=
# Settings → Integrations → Webhook. Signs POST /hooks/zeffy.
ZEFFY_WEBHOOK_SECRET=

# Buffer: Settings → API → create key.
BUFFER_API_KEY=

# Documenso: Settings → API tokens; and the secret set on its webhook
# (Settings → Webhooks → URL https://<core>/hooks/documenso, event DOCUMENT_COMPLETED + DOCUMENT_REJECTED).
DOCUMENSO_API_TOKEN=
DOCUMENSO_WEBHOOK_SECRET=

# Grant outreach delivery (only required when [grants] enabled = true).
# Verify the sending domain in Resend before enabling it.
RESEND_API_KEY=

# GitHub org spec (github/org.toml): a token with org admin rights.
GH_ORG_ADMIN_TOKEN=
